# Copy to .env (never commit real values).

PORT=4000

# PostgreSQL connection string. Leave empty to use an embedded database stored in ./data (development only).
DATABASE_URL=

# Any long random string. Encrypts marketplace credentials at rest; required before a marketplace can be connected.
CREDENTIALS_KEY=

# Password asked for in the app before connecting, disconnecting or syncing a marketplace.
ADMIN_KEY=

# Comma-separated list of site origins allowed to call the API, e.g. https://mobi.onrender.com. Empty allows any origin.
CORS_ORIGINS=http://localhost:5173
